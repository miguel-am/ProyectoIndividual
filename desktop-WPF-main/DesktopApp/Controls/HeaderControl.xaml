<UserControl x:Class="DesktopApp.Controls.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApp.Controls"
             mc:Ignorable="d" 
             MinHeight="56"
             Height="64"
             d:DesignWidth="1280" >
    <Border Background="{StaticResource SecondaryBrushDark}" Padding="16,10">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0"
                    Height="38"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BackgroundBrush2}"
                    Background="{StaticResource BackgroundBrush}"
                    Padding="12,0"
                    MinWidth="220"
                    MaxWidth="800"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path MinWidth="16" MinHeight="16"
                          Stretch="Uniform"
                        Fill="{StaticResource PrimaryBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Data="{StaticResource IcoSearch}"/>

                    <TextBox x:Name="SearchBox"
                        Text="Buscar..."
                        Grid.Column="1"
                        BorderThickness="0"
                        Background="Transparent"
                        FontSize="14"
                        MinHeight="22"
                        VerticalContentAlignment="Center"/>
                </Grid>
            </Border>


            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" MinWidth="36" Width="40" Height="40"
                    VerticalAlignment="Center" ToolTip="Configuración" Style="{StaticResource IconButtonStyle}">
                    <Path 
                        Fill="{StaticResource BackgroundBrush}"
                        MinWidth="18" 
                        MinHeight="18"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Stretch="Uniform"
                        Data="{StaticResource IcoSettings}"/>
                </Button>

                <Border Grid.Column="2" BorderThickness="1"  Width="1" Height="26"  BorderBrush="{StaticResource BackgroundBrush}" Margin="14,0" Opacity="0.6"/>


                <StackPanel x:Name="UserTextPanel"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock Text="{Binding UserName, FallbackValue=Usuario Admin}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BackgroundBrush}"
                               TextAlignment="Right"/>
                    <TextBlock Text="{Binding UserRole, FallbackValue=Administrador}"
                               FontSize="12"
                               Foreground="#CCFFFFFF"
                               TextAlignment="Right"/>
                </StackPanel>


                <Button Grid.Column="4" Width="40" Height="40"
                         Padding="6" VerticalAlignment="Center" ToolTip="IconoUser">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="50">
                                <Grid>
                                    <Image Stretch="UniformToFill" Source="/Resources/images/icono_proyecto.png" Margin="1,6,2,6" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Grid>
    </Border>
</UserControl>
